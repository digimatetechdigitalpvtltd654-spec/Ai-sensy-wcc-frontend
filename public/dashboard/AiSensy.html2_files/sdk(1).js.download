  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
    background: transparent;
  }
  #fb-changelog-popup-root {
    min-height: 100%;
    /* Definite height so the surface's percentage height/max-height resolve
       in standards mode too (the popup iframe is about:blank \u2192 quirks mode
       today, but don't depend on that). */
    height: 100%;
  }
  * { box-sizing: border-box; }
  button { font: inherit; }
  .fb-changelog-popup-surface {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--ladder-tx-4) / 0.5) transparent;
    scrollbar-gutter: stable;
  }
  .fb-changelog-popup-surface::-webkit-scrollbar {
    width: 4px;
    cursor: pointer;
  }
  .fb-changelog-popup-surface::-webkit-scrollbar-track {
    background: transparent;
    cursor: pointer;
  }
  .fb-changelog-popup-surface::-webkit-scrollbar-thumb {
    min-height: 40px;
    border-radius: 20px;
    background-color: hsl(var(--ladder-tx-4) / 0.5);
    cursor: pointer;
  }
  .fb-changelog-popup-surface::-webkit-scrollbar-thumb:hover {
    background-color: hsl(var(--ladder-tx-3) / 0.6);
  }
  .is-mobile {
    border-radius: 0;
    min-height: 100%;
    height: 100%;
  }
  .is-mobile .fb-changelog-popup-close {
    display: none;
  }
  .fb-changelog-comments-scroll {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--foreground) / 0.22) transparent;
  }
  .fb-changelog-comments-scroll::-webkit-scrollbar {
    width: 4px;
  }
  .fb-changelog-comments-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .fb-changelog-comments-scroll::-webkit-scrollbar-thumb {
    min-height: 32px;
    border-radius: 20px;
    background-color: hsl(var(--ladder-tx-4) / 0.5);
  }
  .fb-changelog-comment-content img {
    max-width: 100%;
    border-radius: 8px;
  }
  /* Comments use the changelog rendering pipeline but at a smaller scale;
     !important is needed to beat the high-specificity custom-grays rules */
  .fb-changelog-comment-content .installation-content,
  .fb-changelog-comment-content .installation-content p,
  .fb-changelog-comment-content .installation-content li,
  .fb-changelog-comment-content .installation-content blockquote {
    font-size: 14px !important;
    line-height: 1.55 !important;
  }
  .fb-changelog-comment-content .installation-content h1,
  .fb-changelog-comment-content .installation-content h2,
  .fb-changelog-comment-content .installation-content h3 {
    font-size: 14px !important;
  }
  .fb-changelog-comment-content .installation-content pre,
  .fb-changelog-comment-content .installation-content pre code,
  .fb-changelog-comment-content .installation-content code {
    font-size: 12px !important;
  }
  /* Match portal comment spacing: the changelog article styles give every
     block my-4/my-5 margins and p:empty a min-height, which triples the gap
     for each blank line. The portal renders comment paragraphs with no
     vertical margins and makes a blank line exactly one line tall via
     p:empty::after nbsp (globals.css) \u2014 mirror that here */
  .fb-changelog-comment-content .installation-content > * {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }
  .fb-changelog-comment-content .installation-content p:empty {
    min-height: 0 !important;
  }
  .fb-changelog-comment-content .installation-content p:empty::after {
    content: '\\00A0';
  }
  /* The comment editor reuses the messenger's .styled-content classes, but
     the popup doesn't define the messenger vars those rely on \u2014 pin the
     editor's text and code look to the ladder */
  .fb-changelog-collab-editor .styled-content {
    color: hsl(var(--color-text-primary)) !important;
  }
  .fb-changelog-collab-editor .styled-content code,
  .fb-changelog-collab-editor .styled-content pre {
    background: hsl(var(--ladder-bg-4)) !important;
    color: hsl(var(--color-text-primary)) !important;
    border-radius: 0.4rem;
    padding: 0.2em 0.35em;
    font-size: 0.8rem;
  }
  .fb-changelog-collab-editor .styled-content pre {
    border-radius: 0.5rem;
    padding: 0.5rem 0.625rem;
  }
  .fb-changelog-collab-editor .styled-content pre code {
    background: transparent !important;
    color: inherit !important;
    padding: 0;
  }
  .fb-changelog-collab-editor .styled-content img {
    max-height: 180px;
    width: auto;
    max-width: 100%;
    border-radius: 8px;
  }
