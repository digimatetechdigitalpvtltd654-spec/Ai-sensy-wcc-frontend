  html, body {
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: transparent;
  }
  * { box-sizing: border-box; }
  button { font: inherit; }
  .fb-view-stage {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .fb-view-track {
    display: flex;
    width: 200%;
    transform: translateX(0);
    transition: transform 300ms ease;
    will-change: transform;
  }
  .fb-changelog-root.is-detail .fb-view-track {
    transform: translateX(-50%);
  }
  .fb-view {
    flex: 0 0 50%;
    width: 50%;
    min-width: 0;
    max-height: 285px;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .fb-changelog-root.is-detail .fb-view {
    max-height: 318px;
  }
  .fb-view {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--ladder-tx-4) / 0.5) transparent;
  }
  .fb-changelog-root.is-detail .fb-list-view,
  .fb-changelog-root:not(.is-detail) .fb-detail-view {
    pointer-events: none;
  }
