`):String(t)}function lr(e,t){let n=e.preview;if(!n)return;let r=e=>{let n=e?t[e]:void 0;return n&&typeof n==`object`&&!Array.isArray(n)?Xn(n.text,n.samples??[]):typeof n==`string`?n:``},i=((n.buttons?t[n.buttons]:void 0)??[]).map(e=>e[n.button_label??`text`]).filter(e=>typeof e==`string`&&!!e.trim());return{header:r(n.header),body:r(n.body),footer:r(n.footer),buttons:i}}function ur(e,t,n,r){let i=e.preview,a=new Set(i?[i.header,i.body,i.footer,i.buttons].filter(Boolean):[]),o=e.fields.filter(e=>e.name in t).map(e=>({label:e.label,value:cr(e,t[e.name]),...a.has(e.name)?{in_preview:!0}:{}})).filter(e=>e.value.trim()),s=lr(e,t);return{call_id:n,form:r,title:e.title,rows:o,...s?{preview:s}:{}}}var dr=new URLSearchParams(location.search),fr=window.__BACKEND_URL__??dr.get(`backend`)??void 0??`http://localhost:8080`,pr=dr.get(`project_id`)??dr.get(`tenant_id`)??void 0??``,mr=dr.get(`project_name`)??dr.get(`tenant_name`)??``,hr=dr.get(`user_id`)??``,gr=dr.get(`user_hash`)??``,_r=dr.get(`username`)??``,vr=(()=>{let e=dr.get(`metadata`);if(!e)return{};try{return JSON.parse(e)}catch{return{}}})(),yr=(()=>{let e=dr.get(`context`);if(!e)return{};try{return JSON.parse(e)}catch{return{}}})(),br=dr.get(`page_origin`)??``;(()=>{let e=dr.get(`project_metadata`);if(!e)return{};try{return JSON.parse(e)}catch{return{}}})(),dr.get(`page_url`);var xr=(()=>{let e=(dr.get(`conversation_id`)??``).trim();return/^[a-f0-9]{24}$/i.test(e)?e:``})(),Sr=dr.get(`mode`)??``,Cr=dr.get(`accent_color`)??``,wr=dr.get(`background_color`)??``,Tr=dr.get(`header_title`)??``,Er=dr.get(`user_bubble_color`)??``,Dr=dr.get(`user_text_color`)??``,Or=dr.get(`font_family`)??``,kr=dr.get(`header_name`)??``,Ar=dr.get(`disclaimer_embedded`)??``,jr=dr.get(`disclaimer_topnav`)??``,Mr=(()=>{let e=(dr.get(`logo_url`)??``).trim();return e&&(e.startsWith(`/`)&&!e.startsWith(`//`)||/^https?:\/\//i.test(e))?e:``})(),Nr=dr.get(`icon_tile_style`)??``,Pr={fontSize:[12,24],lineHeight:[14,40],paragraphSpacing:[0,32]};function Fr(e,[t,n]){if(e==null||e===``)return null;let r=typeof e==`number`?e:Number(e);return Number.isFinite(r)&&r>=t&&r<=n?r:null}var Ir=Fr(dr.get(`message_font_size`),Pr.fontSize),Lr=Fr(dr.get(`message_line_height`),Pr.lineHeight),Rr=Fr(dr.get(`message_paragraph_spacing`),Pr.paragraphSpacing),zr=dr.get(`starter_prompt_sends`)===`1`,Br=dr.get(`show_thinking`)!==`0`,Vr=dr.get(`remove_branding`)===`1`,Hr=dr.has(`demo`)||dr.has(`illustrative`)||dr.has(`ff`),Ur=`This is a preview of the AI Agent interface, shown for illustrative purposes only.`,Wr=1800,Gr=[`Show my active campaigns`,`List all my flows`,`Manage my contacts`],Kr=[`Reply loader demo (loops)`,`Setting up my first campaign`,`Importing my contacts`,`Drafting a follow-up email`,`Checking today's leads`,`Scheduling a reminder`,`Exporting a report`,`Updating a customer record`],qr=[[],[{id:`demo-0-0`,role:`user`,text:`How do I set up my first campaign?`},{id:`demo-0-1`,role:`assistant`,thinking:`The user wants to create their first campaign. I should outline the two required inputs — name and audience — and offer to start a draft rather than asking for everything up front.`,text:`I'll walk you through it. First, give the campaign a name and pick an audience — you can start from an existing contact list or build one from scratch. Want me to create a draft now?`,responseId:`demo-r-0-1`},{id:`demo-0-2`,role:`user`,text:`Yes, start with our newsletter list.`},{id:`demo-0-3`,role:`assistant`,thinking:`The newsletter list is an existing audience, so I can create the draft immediately without another round trip. A subject line suggestion saves them the next likely ask.`,text:`Done — I've created a draft campaign targeting your newsletter list. You can review the audience size and edit the message before sending. I've also suggested a subject line: "Here's what's new this month."`,responseId:`demo-r-0-3`,followups:[`Suggest two more subject lines`,`Show me the audience size`]}],[{id:`demo-1-0`,role:`user`,text:`I need to import my contacts from a CSV file.`},{id:`demo-1-1`,role:`assistant`,thinking:`CSV imports usually fail on column-mapping mismatches or missing fields. I should mention the auto-mapping and set expectations for a review step before anything commits.`,text:`Sure — attach the CSV and I'll map the columns to name, email, and phone automatically. If anything looks off, you'll get a chance to fix it before anything is saved.`,responseId:`demo-r-1-1`},{id:`demo-1-2`,role:`user`,text:`What if some rows are missing an email?`},{id:`demo-1-3`,role:`assistant`,thinking:`Missing emails shouldn't block the whole import. Flagging just those rows for review, while importing the rest, is the safer default.`,text:`I'll flag those rows separately so you can review them instead of importing incomplete contacts by accident. Everything else imports normally.`,responseId:`demo-r-1-3`,followups:[`What other fields get validated?`,`Start the import`]},{id:`demo-1-4`,role:`user`,text:`Sounds good, go ahead.`}],[{id:`demo-2-0`,role:`user`,text:`Draft a follow-up email for a lead who went quiet.`},{id:`demo-2-1`,role:`assistant`,thinking:`A quiet lead needs a low-pressure nudge, not a hard sell. Referencing their last question keeps it specific instead of generic.`,text:`Here's a short, friendly draft: checks in on their last question, offers a quick call, and doesn't push for a decision. Want it warmer or more direct?`,responseId:`demo-r-2-1`},{id:`demo-2-2`,role:`user`,text:`A bit more direct, please.`},{id:`demo-2-3`,role:`assistant`,thinking:`A more direct version should add a concrete next step and a deadline, which is what "direct" usually means for a stalled lead.`,text:`Updated — leads with a clear next step and a specific date to reply by. Ready to send, or want to review it first?`,responseId:`demo-r-2-3`,followups:[`Show me the full draft`,`Schedule it for tomorrow morning`]}],[{id:`demo-3-0`,role:`user`,text:`What leads came in today?`},{id:`demo-3-1`,role:`assistant`,thinking:`Six leads is enough that a full dump isn't the most useful first answer — summarizing by source and offering to filter to high-intent is more actionable.`,text:`You have 6 new leads today — 2 from the contact form, 3 from a campaign, and 1 referral. Want the full list, or just the ones flagged as high-intent?`,responseId:`demo-r-3-1`},{id:`demo-3-2`,role:`user`,text:`Just the high-intent ones.`},{id:`demo-3-3`,role:`assistant`,thinking:`Both high-intent leads requested a demo, which is a strong enough signal to proactively offer outreach rather than waiting to be asked.`,text:`2 leads are flagged high-intent — both requested a demo. I can draft outreach for them now if you'd like.`,responseId:`demo-r-3-3`,followups:[`Draft outreach for both`,`Show me the rest of the leads`]}],[{id:`demo-4-0`,role:`user`,text:`Remind me to follow up with Acme Corp next Tuesday.`},{id:`demo-4-1`,role:`assistant`,thinking:`The reminder itself is a one-step action. Offering to attach context (like the last call) up front saves a second message if they want it noted.`,text:`Done — I've set a reminder for Tuesday to follow up with Acme Corp. Want me to attach a note about what to cover?`,responseId:`demo-r-4-1`},{id:`demo-4-2`,role:`user`,text:`Yes — mention the pricing discussion from last call.`},{id:`demo-4-3`,role:`assistant`,thinking:`Straightforward update to the existing reminder — confirming what changed is enough, no further questions needed.`,text:`Added. The reminder now includes a note to continue the pricing discussion from your last call.`,responseId:`demo-r-4-3`,followups:[`Set another reminder`,`Show my upcoming reminders`]}],[{id:`demo-5-0`,role:`user`,text:`Export this month's activity as a report.`},{id:`demo-5-1`,role:`assistant`,thinking:`"This month's activity" is broad — offering a format choice (inline summary vs. file) up front avoids generating the wrong shape of output.`,text:`I can put together a summary covering new contacts, campaigns sent, and response rates for this month. Want it as a quick summary here, or a downloadable file?`,responseId:`demo-r-5-1`},{id:`demo-5-2`,role:`user`,text:`A downloadable file, please.`},{id:`demo-5-3`,role:`assistant`,thinking:`A weekly breakdown is more useful than a single monthly total for spotting trends, so that's worth including even though it wasn't explicitly asked for.`,text:`Generating the report now — it'll include a breakdown by week so you can see the trend, not just the totals.`,responseId:`demo-r-5-3`,followups:[`Email me the file when ready`,`Also break it down by campaign`]}],[{id:`demo-6-0`,role:`user`,text:`Update the phone number on the Jane Cooper record.`},{id:`demo-6-1`,role:`assistant`,thinking:`Updating a phone number could mean replacing it or keeping the old one as a fallback — better to ask than guess and lose data either way.`,text:`Sure — what's the new number, and should I keep the old one on file as a secondary contact?`,responseId:`demo-r-6-1`},{id:`demo-6-2`,role:`user`,text:`New number only, replace the old one.`},{id:`demo-6-3`,role:`assistant`,thinking:`They explicitly said "replace," so the old number should be removed outright, not just hidden behind the new one — worth confirming that distinction back to them.`,text:`Updated Jane Cooper's record with the new number. The old one has been removed, not just hidden, since you asked to replace it.`,responseId:`demo-r-6-3`,followups:[`Show me the full record`,`Update another contact`]}]],Jr={question:`How did this week's campaigns do?`,steps:[{at:3500,tool:{id:`loader-t1`,name:`load_skill`,input:{name:`Campaign Analytics`}}},{at:7e3,tool:{id:`loader-t2`,name:`http_request`,input:{method:`GET`,url:`https://api.example.com/v1/campaigns`}}},{at:10500,tool:{id:`loader-t3`,name:`http_request`,input:{method:`GET`,url:`https://api.example.com/v1/broadcasts`}}},{at:14e3,tool:{id:`loader-t4`,name:`http_request`,input:{method:`GET`,url:`https://api.example.com/v1/replies`}}},{at:17e3,tool:{id:`loader-t5`,name:`http_request`,input:{method:`GET`,url:`https://api.example.com/v1/contacts`}}}],introAt:5e3,intro:`Let me pull this week's campaign numbers.

`,answerAt:2e4,streamFor:2200,answer:`You ran **3 campaigns** this week, reaching **12,480 contacts**.

- **Diwali Offer** had the best read rate at **68%**, with 412 replies.
- **Restock Alert** was delivered to 96% of its list but drew few replies.
- **Feedback Survey** is still sending and is 40% through its audience.

Want me to resend Restock Alert to the people who did not read it?`,followups:[`Resend to non-readers`,`Compare with last week`],holdFor:4500},Yr={"demo-0-3":{thinking:`Rephrasing without changing the outcome — still confirm the draft exists, still offer the subject line, just less report-like and more conversational.`,text:`Your draft campaign is set up and targeting the newsletter list — take a look at the audience size and message whenever you're ready to edit. I went ahead and drafted a subject line too: "Here's what's new this month."`},"demo-1-3":{thinking:`Same policy, lighter phrasing — lead with the reassurance instead of the mechanism.`,text:`No accidental imports — anything missing an email gets set aside for you to check, and the rest goes through as normal.`},"demo-2-3":{thinking:`Same edit, described from the reader's point of view instead of the change log.`,text:`Here's the more direct version — it gives them a clear next step and a date to respond by. Want me to send it now, or would you like one more look first?`},"demo-3-3":{thinking:`Lead with the offer this time instead of the count — it's the more actionable half of the answer.`,text:`Both of your high-intent leads asked for a demo — want me to put together outreach for them right now?`},"demo-4-3":{thinking:`Confirm the same change with less "added a note to a note" phrasing.`,text:`Done — your Tuesday reminder for Acme Corp now includes the pricing discussion from your last call.`},"demo-5-3":{thinking:`Same report, framed around what they'll be able to see rather than what's being generated.`,text:`Your report is on its way — broken down week by week so the trend is easy to spot, not just this month's totals.`},"demo-6-3":{thinking:`Same fact (old number truly removed), stated more plainly up front.`,text:`Jane Cooper's old number is gone, not just replaced on the surface — her record now shows only the new one, exactly as you asked.`}};function Xr(e){return e.nativeEvent.isComposing||e.keyC